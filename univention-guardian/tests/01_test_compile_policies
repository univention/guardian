#!/usr/share/ucs-test/runner bash
# shellcheck shell=bash
## desc: Compile and test the shipped Guardian policies with cerbos compile
## tags: [guardian]
## exposure: safe
## packages:
##   - univention-guardian-server

# Validate (compile) the shipped policies on the installed tree, running any
# policy test suites found alongside them. The policies are mounted read-only,
# so this leaves the system unchanged.
#
# SPDX-FileCopyrightText: 2026 Univention GmbH
# SPDX-License-Identifier: AGPL-3.0-only

docker run --rm -i \
  -v /usr/share/univention-guardian-server/policies:/policies:ro \
  ghcr.io/cerbos/cerbos:0.54.0@sha256:211c261f6031675522a35c6055b13fd719c4aff13747307e4bcb6907326537ef compile --verbose \
  /policies

exit $?
