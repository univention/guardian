[guardian/cerbos/log-level]
Description[en]=Cerbos log level. One of DEBUG, INFO, WARN, ERROR.
Description[de]=Cerbos Log-Level. Einer von DEBUG, INFO, WARN, ERROR.
Type=str
Categories=service-guardian
Default=WARN
Regex=^(DEBUG|INFO|WARN|ERROR)$

[guardian/cerbos/audit-logging/enabled]
Description[en]=Enables Cerbos audit logging, writing access and decision logs to stdout. Defaults to disabled.
Description[de]=Aktiviert das Cerbos-Audit-Logging, wobei Zugriffs- und Entscheidungsprotokolle nach stdout geschrieben werden. Standardmäßig deaktiviert.
Type=bool
Categories=service-guardian
Default=false
