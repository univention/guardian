[Application]
ID = univention-guardian
Code = 52
Name = Univention Guardian
Version = 1.0.0
SupportedUcsVersions = 5.2-0
License = free
WithoutRepository = True
NotifyVendor = False
Description = Cerbos-based authorization engine for UCS.
LongDescription = <p>
	The Univention Guardian is the authorization engine for UCS. This app
	installs the univention-guardian-server package, which runs Cerbos as a
	local policy decision point (PDP) and ships a set of policies. Other apps
	can depend on this component to use a ready-to-run policy engine.
	</p>
Categories = UCS components
Contact = sales@univention.de
NotificationEmail = appcenter-reporting@univention.de
Maintainer = Univention GmbH
WebsiteMaintainer = https://www.univention.com/
DefaultPackages = univention-guardian-server
ServerRole = domaincontroller_master, domaincontroller_backup
AppCategories = Security

